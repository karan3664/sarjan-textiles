# Sarjan Textiles — Development (dev.sarjantextiles.com)
# Copy to Coolify "dev" application environment variables.
# NEVER use production DATABASE_URL here.

APP_ENV=development
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://dev.sarjantextiles.com
NEXT_PUBLIC_SITE_URL=https://dev.sarjantextiles.com

# Isolated dev database (Coolify Postgres: sarjan-dev-db)
DATABASE_URL=postgresql://sarjan_dev:CHANGE_ME@sarjan-dev-postgres:5432/sarjan_dev

# Unique secrets per environment (do not copy from production)
ADMIN_SESSION_SECRET=dev-change-me-long-random
CLIENT_JWT_SECRET=dev-change-me-long-random
CRON_SECRET=dev-cron-secret

# Uploads isolation — files under public/uploads/dev/
UPLOADS_ENV_PREFIX=dev

# Analytics OFF in development
ENABLE_ANALYTICS=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Logging
LOG_LEVEL=debug

# Optional: disable outbound email in dev
# SMTP_DEV_CONSOLE_OTP=true

# AI — separate OpenAI key / memory namespace (optional override)
# AI_MEMORY_NAMESPACE=dev

# Redis (optional, isolated instance)
# REDIS_URL=redis://sarjan-dev-redis:6379

# See .env.example for full variable list (SMTP, Firebase, etc.)
