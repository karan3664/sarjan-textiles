# Sarjan Textiles — Staging (staging.sarjantextiles.com)
# Copy to Coolify "staging" application environment variables.
# NEVER use production DATABASE_URL here.

APP_ENV=staging
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://staging.sarjantextiles.com
NEXT_PUBLIC_SITE_URL=https://staging.sarjantextiles.com

# Isolated staging database (Coolify Postgres: sarjan-staging-db)
DATABASE_URL=postgresql://sarjan_staging:CHANGE_ME@sarjan-staging-postgres:5432/sarjan_staging

# Unique secrets per environment
ADMIN_SESSION_SECRET=staging-change-me-long-random
CLIENT_JWT_SECRET=staging-change-me-long-random
CRON_SECRET=staging-cron-secret

UPLOADS_ENV_PREFIX=staging

# Test analytics only — use GA4/Meta test property IDs
ENABLE_ANALYTICS=true
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=

LOG_LEVEL=info

# AI — isolated from production
# AI_MEMORY_NAMESPACE=staging

# REDIS_URL=redis://sarjan-staging-redis:6379

# See .env.example for full variable list.
