{
  "name": "sarjan-textiles",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "dev:clean": "rm -rf .next && next dev -p 3001",
    "build": "next build",
    "build:docker": "next build --no-lint",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "test:notifications": "tsx --env-file=.env.local scripts/test-client-notifications.ts",
    "test:sarjan-ai": "npx tsx --env-file=.env.local scripts/test-sarjan-ai-suite.ts",
    "test:sarjan-ai-31": "npx tsx scripts/test-sarjan-ai-31-suite.ts",
    "test:sarjan-ai:screenshots": "RUN_SCREENSHOTS=1 npx tsx --env-file=.env.local scripts/test-sarjan-ai-suite.ts",
    "test:admin-send": "tsx --env-file=.env.local scripts/test-admin-send-notification.ts",
    "test:e2e": "node --env-file=.env.local node_modules/@playwright/test/cli.js test",
    "test:e2e:audit": "node --env-file=.env.local node_modules/@playwright/test/cli.js test --project=chromium-desktop && node scripts/generate-e2e-audit-report.mjs",
    "test:e2e:qa": "node --env-file=.env.local node_modules/@playwright/test/cli.js test --project=chromium-desktop e2e/07-senior-qa-ui.spec.ts e2e/05-audit.spec.ts && node scripts/generate-e2e-audit-report.mjs",
    "test:e2e:full": "node --env-file=.env.local node_modules/@playwright/test/cli.js test --project=chromium-desktop --project=b2b-lifecycle && node scripts/generate-e2e-audit-report.mjs",
    "test:e2e:b2b": "node --env-file=.env.local node_modules/@playwright/test/cli.js test --project=b2b-lifecycle && node scripts/generate-e2e-audit-report.mjs",
    "test:e2e:local": "PLAYWRIGHT_SKIP_WEBSERVER=1 node --env-file=.env.local node_modules/@playwright/test/cli.js test",
    "test:e2e:report": "npx playwright show-report playwright-report",
    "test:e2e:ui": "node --env-file=.env.local node_modules/@playwright/test/cli.js test --ui",
    "cms:push": "node scripts/sync-cms.mjs push",
    "cms:pull": "node scripts/sync-cms.mjs pull",
    "cms:pull-db": "node scripts/sync-cms.mjs pull-db",
    "cms:push-product-images": "node scripts/sync-cms.mjs push-product-images",
    "cms:push-product-colors": "node scripts/sync-cms.mjs push-product-colors",
    "cms:push-categories": "node scripts/sync-cms.mjs push-categories",
    "cms:sync-categories": "tsx --env-file=.env.local scripts/sync-categories-from-products.ts",
    "cms:sync-colors": "node scripts/sync-product-colors-to-image-order.mjs",
    "cms:sync-kaftan-colors": "node scripts/sync-kaftan-visual-colors.mjs",
    "cms:sync-single-color": "node scripts/sync-single-image-product-colors.mjs",
    "cms:list-backups": "node scripts/sync-cms.mjs list-backups",
    "cms:restore-backup": "node scripts/sync-cms.mjs restore-backup",
    "cms:sync-uploads": "bash scripts/vps/sync-uploads.sh",
    "cms:pull-uploads": "bash scripts/vps/pull-uploads.sh",
    "cms:pull-uploads:http": "node scripts/pull-uploads-http.mjs",
    "cms:align-colors-from-images": "node scripts/align-cms-colors-from-images.mjs",
    "cms:replace-images": "node scripts/replace-product-images-bulk.mjs"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "@tiptap/extension-color": "^3.26.0",
    "@tiptap/extension-font-family": "^3.26.0",
    "@tiptap/extension-text-style": "^3.26.0",
    "@tiptap/extension-underline": "^3.26.0",
    "@tiptap/pm": "^3.26.0",
    "@tiptap/react": "^3.26.0",
    "@tiptap/starter-kit": "^3.26.0",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "emoji-picker-react": "^4.19.1",
    "exceljs": "^4.4.0",
    "firebase-admin": "^13.0.2",
    "framer-motion": "^12.39.0",
    "google-auth-library": "^10.6.2",
    "india-pincode": "^2.5.9",
    "lucide-react": "^0.468.0",
    "next": "^15.3.2",
    "nodemailer": "^8.0.7",
    "nsfwjs": "^4.3.0",
    "pg": "^8.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-is": "^19.1.0",
    "recharts": "^2.15.0",
    "sanitize-html": "^2.17.4",
    "sharp": "^0.34.5",
    "three": "^0.184.0"
  },
  "overrides": {
    "react-is": "$react-is",
    "uuid": "^11.1.1",
    "tmp": "^0.2.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.52.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.15.17",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.15.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "@types/sanitize-html": "^2.16.1",
    "@types/three": "^0.184.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.26.0",
    "eslint-config-next": "^15.3.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}
