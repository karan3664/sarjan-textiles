# Sarjan Textiles — Production (sarjantextiles.com)
# Copy to Coolify "production" application environment variables.
# DO NOT change production values without a release window.

APP_ENV=production
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://sarjantextiles.com
NEXT_PUBLIC_SITE_URL=https://sarjantextiles.com
ADMIN_HOST=admin.sarjantextiles.com
NEXT_PUBLIC_ADMIN_URL=https://admin.sarjantextiles.com

# Production database only (sarjan-production-db / sarjan-postgres)
DATABASE_URL=postgresql://sarjan:CHANGE_ME@sarjan-postgres:5432/sarjan_textiles

ADMIN_SESSION_SECRET=production-long-random-secret
CLIENT_JWT_SECRET=production-long-random-client-secret
CRON_SECRET=production-cron-secret

UPLOADS_ENV_PREFIX=production

ENABLE_ANALYTICS=true
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=

LOG_LEVEL=warn

# See .env.example for ADMIN_PASSWORD_HASH_B64, Firebase, SMTP, etc.
