NEXT_PUBLIC_SITE_URL=https://sarjantextiles.com
# Optional: `.sarjantextiles.com` so login cookies work on both apex and www (auto-derived from SITE_URL if unset)
# SESSION_COOKIE_DOMAIN=.sarjantextiles.com
ADMIN_EMAIL=admin@sarjantextiles.com
# Admin login — bcrypt hash only (never store plaintext ADMIN_PASSWORD in env).
# Generate: node -e "import('bcryptjs').then(b=>console.log(b.hashSync('your-password',10)))"
# REQUIRED for local + Coolify: base64 hash (Next.js and Docker both expand `$` in plain hashes).
# node -e "console.log(Buffer.from('$2b$10$...').toString('base64'))"
ADMIN_PASSWORD_HASH_B64=
# Do not use ADMIN_PASSWORD_HASH in .env.local — even single quotes get truncated by Next.js.
ADMIN_SESSION_SECRET=change-this-long-random-secret
# Obscure admin sign-in URL (not /admin/login). Must start with / and must not be under /admin.
# ADMIN_LOGIN_PATH=/st-ctl-k8m4x7p2
CLIENT_JWT_SECRET=change-this-long-random-client-secret
ADMIN_USERS_JSON=
DATABASE_URL=
# Protects /api/cron/* (daily backup 02:00 IST, abandoned-cart reminders).
# Abandoned cart FCM: first nudge after 6h idle, second after 24h, then every 12h (max ~2/day).
# ABANDONED_CART_FIRST_REMINDER_HOURS=6
# ABANDONED_CART_SECOND_REMINDER_HOURS=24
# ABANDONED_CART_REPEAT_REMINDER_HOURS=12
CRON_SECRET=
# Pre-launch gate: ISO datetime with timezone. Unset = site live. Example 17 Jun 2026 12:39 PM IST:
# SITE_LAUNCH_AT=2026-06-17T12:39:00+05:30
SITE_LAUNCH_AT=
# Hostinger VPS Postgres (see docs/VPS-COOLIFY.md). Required in production.
# Example: postgresql://sarjan:password@sarjan-postgres:5432/sarjan_textiles
# Firebase Cloud Messaging (mobile push). Paste the full service-account JSON
# (single line) OR its base64. Leave blank to disable push — site still works.
FIREBASE_SERVICE_ACCOUNT=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sarjan Textiles <info@sarjantextiles.com>"
# Live / staging: set SMTP_HOST, SMTP_USER, SMTP_PASS (and usually SMTP_FROM).
# Local without SMTP: use `next dev` and set below — OTP prints in the terminal only.
# SMTP_DEV_CONSOLE_OTP=true
# Mobile app APK — version read from public/downloads/mobile-release.json (npm run release:apk in app repo).
# Optional overrides only (normally leave unset):
# MOBILE_APP_LATEST_VERSION=1.0.27
# MOBILE_APP_VERSION_CODE=28
# MOBILE_APP_APK_FILE=sarjan-textiles.apk
# MOBILE_APP_FORCE_UPDATE=false
# Optional override — normally releaseNotes come from public/downloads/mobile-release.json (npm run release:apk).
# MOBILE_APP_RELEASE_NOTES=
# Android App Links — release keystore SHA-256 (colons ok). Enables https:// links to open the app directly.
# MOBILE_APP_SHA256_FINGERPRINT=AA:BB:CC:...
# iOS Universal Links (apple-app-site-association) — defaults match SarjanTextiles Xcode target.
# IOS_APP_TEAM_ID=LGANQS28JG
# IOS_APP_BUNDLE_ID=org.reactjs.native.example.SarjanTextiles
# SMS_DEV_CONSOLE_OTP=true  (legacy — mobile OTP is Firebase-only in the app)

# Optional: allow GET /dev/email-preview on non-dev (e.g. staging). Never enable on public prod.
# ENABLE_DEV_EMAIL_PREVIEW=true

# Skip NSFW model on client avatar upload (local only — never on public production).
# DISABLE_AVATAR_NSFW=true

# Storefront: EU-style cookie gate + analytics deferral
# Cookie consent + deferred GA (default on). Set false to load analytics without a banner.
# NEXT_PUBLIC_COOKIE_CONSENT=false
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX

# Checkout: guest marketing copy (inquiry path). Paid submit still requires login.
# NEXT_PUBLIC_GUEST_CHECKOUT_MARKETING=true

# GST on checkout/cart subtotal (decimal). Shown only when logged-in client has GSTIN saved.
# NEXT_PUBLIC_GST_RATE_ON_SALE=0.05

# GST registration verification: GET /api/gst/captcha + POST /api/gst/verify with captcha (see docs/COMMERCE-OPERATIONS.md).
# Captcha sessions are in-memory — use one stable Node instance or Redis for multi-instance hosts.
# Optional: your own HTTPS POST { gstin } lookup (GSP / aggregator) instead of portal+captcha:
# SARJAN_GST_LOOKUP_URL=
# SARJAN_GST_LOOKUP_SECRET=

# Admin commerce hub: credit alert threshold (INR)
# COMMERCE_CREDIT_ALERT_INR=250000

# Compliance outbound hooks (your ERP / middleware HTTPS URLs)
# E_INVOICE_WEBHOOK_URL=
# E_WAY_WEBHOOK_URL=

# CMS: two-step publish process flag (pair with reviewer role in your workflow)
# CONTENT_PUBLISH_TWO_STEP=false

# AI Product Studio — filesystem (Vercel uses /tmp automatically when VERCEL is set).
# Optional overrides (absolute paths recommended in production).
# AI_STUDIO_DATA_DIR=
# AI_STUDIO_PUBLIC_DIR=

# Homepage Instagram gallery — live posts via Meta Graph API (Business/Creator account).
# Without these, the site embeds the public profile: instagram.com/{username}/embed
# 1) Meta app → Instagram Graph API → long-lived Page access token
# 2) Instagram account must be Business/Creator linked to a Facebook Page
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Optional overrides (default: sarjantextiles + CMS instagram URL)
# INSTAGRAM_USERNAME=sarjantextiles
# INSTAGRAM_PROFILE_URL=https://www.instagram.com/sarjantextiles/

# AI Product Studio image provider: vertex, openai, or local.
# If Vertex project id is missing but OPENAI_API_KEY is set, OpenAI is used automatically.
AI_IMAGE_PROVIDER=openai
# preserve (default) = exact product pixels, background cleanup only.
# generative = OpenAI/Vertex may change print, color, logo, or buttons.
AI_IMAGE_CATALOG_MODE=preserve

# Google Vertex AI Imagen. Use service-account JSON via GOOGLE_APPLICATION_CREDENTIALS.
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
VERTEX_IMAGEN_MODEL=imagen-3.0-capability-001
VERTEX_IMAGEN_EDIT_STEPS=75
VERTEX_IMAGEN_MASK_DILATION=0

# Optional OpenAI fallback when AI_IMAGE_PROVIDER=openai.
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=medium
ORDER_BOT_LLM_ENABLED=true
ORDER_BOT_LLM_MODEL=gpt-4o-mini

# CMS sync to live VPS (npm run cms:sync-uploads) — see docs/CMS-SYNC.md
# VPS_HOST=69.62.77.149
# VPS_USER=root
# VPS_SSH_PRIVATE_KEY=~/.ssh/id_ed25519
# REMOTE_UPLOADS_DIR=/data/coolify/applications/YOUR_APP_UUID/public/uploads

# Mobile visual search (OpenAI vision when OPENAI_API_KEY is set).
# VISUAL_SEARCH_MODEL=gpt-4o-mini


# B2B order assistant (storefront chat widget for approved clients).
# With OPENAI_API_KEY: ChatGPT-style assistant (catalog, cart, orders, tracking — site only).
# Mobile CMS auto-translates admin English copy to Hindi & Gujarati (OpenAI preferred; MyMemory fallback).
# Without key: rule-based fallback.
# ORDER_BOT_LLM_ENABLED=true
# ORDER_BOT_LLM_MODEL=gpt-4o-mini
# ORDER_BOT_ENABLED=true
